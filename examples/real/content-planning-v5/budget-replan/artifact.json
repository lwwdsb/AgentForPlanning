, "kind": "estimate_cost", "reusable": true, "status": "succeeded", "step_id": "step_6e6bf3030c7244a6b0fe97118b46dfee"}, {"artifact_ids": ["script_3bbecde5e46945daa966857081b48d7f"], "candidate_revision": 2, "depends_on": ["step_58c9890ae0a34059974de9cc5b04487c", "step_6e6bf3030c7244a6b0fe97118b46dfee"], "kind": "generate_script", "reusable": true, "status": "succeeded", "step_id": "step_b6d5067871b14a3ab79689604789e980"}, {"artifact_ids": [], "candidate_revision": 2, "depends_on": ["step_58c9890ae0a34059974de9cc5b04487c", "step_b6d5067871b14a3ab79689604789e980"], "kind": "estimate_cost", "reusable": true, "status": "succeeded", "step_id": "step_32542ebc724b405cb6b0e4b9e3da2b6c"}, {"artifact_ids": ["plan_ea034660c00549c99e4d7486aa09227a"], "candidate_revision": 2, "depends_on": ["step_b6d5067871b14a3ab79689604789e980", "step_32542ebc724b405cb6b0e4b9e3da2b6c"], "kind": "save_plan", "reusable": true, "status": "succeeded", "step_id": "step_c5e8ef4a533b4bf389e73a7a51ffbce0"}], "materials": [{"material_id": "reading-1", "tags": ["校园", "读书", "阅读"], "text": "【合成素材】校园读书周提供书单分享、读书打卡和读后感交流。活动地点与具体日期待运营确认。", "topic": "校园读书周", "version": "1.0"}, {"material_id": "reading-2", "tags": ["校园", "读书"], "text": "【合成素材】可使用图文预告、短视频或精简文案。参与者可分享一本推荐书及理由；不承诺奖品或参与人数。", "topic": "校园读书周", "version": "1.0"}], "script": {"artifact_id": "script_3bbecde5e46945daa966857081b48d7f", "candidate_revision": 2, "content": {"assumptions": ["premium视频脚本12.00超预算2.00，降级为standard图文预告", "不承诺奖品或参与人数", "活动地点与具体日期未定，需运营确认", "预算10.00，截止2026-10-29T06:41Z"], "assumptions_are_user_facts": false, "audience": "校园内学生（假设）", "delivery": {"copy": "校园读书周来啦！\n\n这一周，我们围绕阅读做了三件事：书单分享、读书打卡、读后感交流。不用把书读得多“高级”，只要是你真心想推荐的一本。\n\n参与方式很简单：分享一本你推荐的书，以及推荐它的理由——可能是某个让你停下来的句子，也可能是它陪你度过的那段时间。分享之后，欢迎按自己的节奏参与读书打卡，把每天读到的片段留个记录；读完想说的话，也可以写成读后感与大家交流。\n\n我们会把这些推荐与记录汇集起来，做成一份属于校园的书单，让下一个想读书的人在别人的理由里找到自己的下一本。\n\n活动地点与具体日期待确认，确认后在此更新。\n\n带上你正在读的那本书，来读书周见。", "format": "image_text", "operational_suggestions": ["活动具体日期与地点待运营确认后补充到正文", "发布渠道（校内公众号/社群/海报位）待确认", "不建议在正文中承诺奖品、名次或参与人数"], "scenes": [], "source_facts": [{"material_id": "reading-1", "quote": "【合成素材】校园读书周提供书单分享、读书打卡和读后感交流。活动地点与具体日期待运营确认。"}, {"material_id": "reading-2", "quote": "【合成素材】可使用图文预告、短视频或精简文案。参与者可分享一本推荐书及理由；不承诺奖品或参与人数。"}], "title": "校园读书周｜把你的那本书推荐出来"}, "fact_policy": "Only source_facts are exact retrieved quotations; all creative and operational text is unconfirmed.", "goal": "以图文预告校园读书周，吸引学生参与书单分享与读书打卡", "pricing_scope": {"excludes": ["additional_deliverables", "filming", "graphic_design", "distribution"], "format": "image_text", "included_deliverables": ["image_text"], "max_copy_chars": 600, "max_scenes": 0, "pricing_basis": "one_script_draft"}, "publication_status": "requires_operator_review", "text": "素材事实（逐字引用）\n[reading-1] 【合成素材】校园读书周提供书单分享、读书打卡和读后感交流。活动地点与具体日期待运营确认。\n[reading-2] 【合成素材】可使用图文预告、短视频或精简文案。参与者可分享一本推荐书及理由；不承诺奖品或参与人数。\n\n创意草稿（待运营审核）\n交付形式：图文正文\n以下标题、正文或分镜均为创意建议；新增事实、渠道和参与规则须运营确认。\n校园读书周｜把你的那本书推荐出来\n校园读书周来啦！\n\n这一周，我们围绕阅读做了三件事：书单分享、读书打卡、读后感交流。不用把书读得多“高级”，只要是你真心想推荐的一本。\n\n参与方式很简单：分享一本你推荐的书，以及推荐它的理由——可能是某个让你停下来的句子，也可能是它陪你度过的那段时间。分享之后，欢迎按自己的节奏参与读书打卡，把每天读到的片段留个记录；读完想说的话，也可以写成读后感与大家交流。\n\n我们会把这些推荐与记录汇集起来，做成一份属于校园的书单，让下一个想读书的人在别人的理由里找到自己的下一本。\n\n活动地点与具体日期待确认，确认后在此更新。\n\n带上你正在读的那本书，来读书周见。\n\n运营建议（待确认，不属于已确认活动规则）\n活动具体日期与地点待运营确认后补充到正文\n发布渠道（校内公众号/社群/海报位）待确认\n不建议在正文中承诺奖品、名次或参与人数\n本次报价仅涵盖所列单份脚本草稿；新增物料须另行规划估价，不包含实际拍摄、设计或投放。"}, "kind": "script", "request_id": "real-budget-replan-20261028T064128Z-a63420", "source_ids": ["reading-1", "reading-2"], "validity": "valid"}, "spent_total": "8.00", "task_plan": [{"action": "素材检索", "state": "succeeded"}, {"action": "脚本生成", "state": "succeeded"}, {"action": "费用复核", "state": "succeeded"}, {"action": "方案保存", "state": "succeeded"}], "theme": "校园读书周", "time_summary": {"deadline_met": true, "logical_now_utc": "2026-10-28T06:53:39.876565Z", "simulated_elapsed_seconds": 720}}, "kind": "plan", "request_id": "real-budget-replan-20261028T064128Z-a63420", "source_ids": ["script_3bbecde5e46945daa966857081b48d7f",