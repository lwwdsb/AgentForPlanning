动地点：待运营确认\n（不承诺奖品或参与人数，以官方通知为准。）"}, "kind": "script", "request_id": "real-budget-replan-20261028T051059Z-49a791", "source_ids": ["reading-1", "reading-2"], "validity": "valid"}, "spent_total": "8.00", "task_plan": [{"action": "素材检索", "state": "succeeded"}, {"action": "脚本生成", "state": "succeeded"}, {"action": "费用复核", "state": "succeeded"}, {"action": "方案保存", "state": "succeeded"}], "theme": "校园读书周", "time_summary": {"deadline_met": true, "logical_now_utc": "2026-10-28T05:23:11.094180Z", "simulated_elapsed_seconds": 720}}, "kind": "plan", "request_id": "real-budget-replan-20261028T051059Z-49a791", "source_ids": ["script_8c36805c4a8443cb996387d0f6eb897f", "reading-1", "reading-2"], "validity": "valid"}
