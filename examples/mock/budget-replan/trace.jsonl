idity": "valid"}, "status": "success"}, "status": "succeeded", "step_id": "step_c2c84d902c4e40c58e1a0e404bbe37e2"}, "request_id": "budget-replan", "round": 4, "run_id": "run_b9dcf5152db449c38eb72e7c1834933d", "schema_version": "1.0.0", "sequence": 20, "timestamp": "2026-10-28T06:49:11.729488Z"}
