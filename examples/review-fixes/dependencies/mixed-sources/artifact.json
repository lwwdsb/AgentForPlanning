stribution"], "format": "image_text", "included_deliverables": ["image_text"], "max_copy_chars": 600, "max_scenes": 0, "pricing_basis": "one_script_draft"}, "publication_status": "requires_operator_review", "text": "素材事实（逐字引用）\n[green-1] 【合成素材】倡导自带水杯和回收分类，活动规则需运营审核。\n[reading-1] 【合成素材】校园读书周提供书单分享、读书打卡和读后感交流。活动地点与具体日期待运营确认。\n\n创意草稿（待运营审核）\n交付形式：图文正文\n以下标题、正文或分镜均为创意建议；新增事实、渠道和参与规则须运营确认。\n主题活动策划草稿\n欢迎了解主题活动，按运营确认的规则参与并分享体验。\n\n运营建议（待确认，不属于已确认活动规则）\n建议先确认日期、地点和发布渠道，再发布审核后的内容。\n本次报价仅涵盖所列单份脚本草稿；新增物料须另行规划估价，不包含实际拍摄、设计或投放。"}, "kind": "script", "request_id": "dependency-mixed-sources", "source_ids": ["green-1", "reading-1"], "validity": "valid"}, "spent_total": "8.00", "task_plan": [{"action": "素材检索", "state": "succeeded"}, {"action": "脚本生成", "state": "succeeded"}, {"action": "费用复核", "state": "succeeded"}, {"action": "方案保存", "state": "succeeded"}], "theme": "校园读书周", "time_summary": {"deadline_met": true, "logical_now_utc": "2026-10-28T06:53:59.071214Z", "simulated_elapsed_seconds": 780}}, "kind": "plan", "request_id": "dependency-mixed-sources", "source_ids": ["script_ebc105229a6740eaa705ee7d801b6b0a", "green-1", "reading-1"], "validity": "valid"}
