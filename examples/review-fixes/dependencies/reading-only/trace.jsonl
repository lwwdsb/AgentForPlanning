ity": "valid"}, "status": "success"}, "status": "succeeded", "step_id": "step_27eb2bfe22054774b18a5fedf07f35b6"}, "request_id": "dependency-reading-only", "round": 4, "run_id": "run_ed3ab15d204949ea8e02fe7d6f8408c3", "schema_version": "1.0.0", "sequence": 20, "timestamp": "2026-10-28T06:52:59.031200Z"}
